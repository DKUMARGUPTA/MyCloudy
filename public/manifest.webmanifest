{
  "id": "/",
  "name": "Sidocs — Free Document Tools",
  "short_name": "Sidocs",
  "description": "Free, privacy-first document tools — convert, merge, edit, sign and OCR PDF files 100% on your device. English + हिंदी. No signup, no uploads.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FFFFFF",
  "theme_color": "#0B1220",
