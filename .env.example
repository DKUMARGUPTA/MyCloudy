# DocoPDF — environment template (cp .env.example .env)
# Non-secret sandbox defaults. Production values live in Vercel env vars,
# NEVER in this repo (hard rule 7). Optional keys are honestly degradable:
# the app reports "not configured" instead of failing.

# --- required (sandbox) ---
# SQLite file used by Prisma (metadata only — never file content).
DATABASE_URL="file:./db/docopdf.db"

# --- sandbox-only demo mode ---
# Enables the full billing demo journey locally (checkout → pro). NEVER set
# in production.
# BILLING_DEMO=1

# --- optional: auth sessions (JWT signing) ---
# Set a long random string in production. Missing → insecure dev fallback
# with a console warning.
# AUTH_SECRET=

# --- optional: AI provider (3 deferred tools stay 503 until set) ---
# Any OpenAI-compatible endpoint. See docs/rules/13-INTEGRATIONS.md.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# --- optional: GA4 (consent-gated, first-party analytics is built-in) ---
# NEXT_PUBLIC_GA_ID=

# --- optional: payment providers (limits stay shadow-mode until set) ---
# RAZORPAY_KEY_ID=
# STRIPE_SECRET_KEY=

# --- optional: search-console verification meta tags ---
# NEXT_PUBLIC_GSC_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
