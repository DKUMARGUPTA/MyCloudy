// DocoPDF database schema — mirrors PRD §2.5 (Turso/libSQL tables).
// Sandbox: Prisma + SQLite. Production: swap datasource to Turso (libSQL)
// or port to Drizzle — table/column names match the PRD exactly.
//
// HARD RULE: metadata only. NEVER store PDF content or file names.

generator client {
  provider        = "prisma-client-js"
  // R46: driver adapters let the same client run on Turso/libSQL in
  // production (@prisma/adapter-libsql) while the sandbox keeps plain
  // SQLite via DATABASE_URL=file:… — adapter is opt-in per constructor.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  name         String?
  passwordHash String?
  oauthId      String?
  plan         String    @default("free")
  locale       String    @default("en")
  role         String    @default("user")
  tokenVersion Int       @default(0)
  bannedAt     DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  sessions      Session[]
  subscriptions Subscription[]
  payments      Payment[]
  bugReports     BugReport[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  uaHash    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AnonUsage {
  anonId String
  toolId String
  day    String // YYYY-MM-DD
  count  Int    @default(0)

  @@id([anonId, toolId, day])
  @@map("anon_usage")
}

model UsageEvent {
  id         String   @id @default(uuid())
  toolId     String
  mode       String // "D" | "S"
  success    Boolean
  durationMs Int
  sizeBucket String
  locale     String
  day        String
  createdAt  DateTime @default(now())

  @@index([toolId, day])
  @@map("usage_events")
}

/// First-party page-view analytics (R42). Privacy rules mirror UsageEvent:
/// aggregate metadata only — NO IP, NO raw user agent, NO cross-site
/// identifiers. visitorId is the same anonymous localStorage id the usage
/// beacon uses (see src/lib/usage-beacon.ts); device is a coarse class,
/// referrer is a bucket (direct/search/social/internal/other), path is the
/// normalized app route. Purpose: product improvement (DPDP purpose
/// limitation). Owner-only surfaces (/admin, /accounting) are excluded
/// client- AND server-side so the owner's own sessions never pollute data.
model PageView {
  id        String   @id @default(uuid())
  path      String // "/", "/tools", "/tool/merge-pdf", "/page/contact"…
  locale    String // "en" | "hi" (UI locale at view time)
  device    String // "mobile" | "tablet" | "desktop"
  referrer  String // "direct" | "search" | "social" | "internal" | "other"
  visitorId String // anonymous per-browser id (usage-beacon ANON_KEY)
  day       String // YYYY-MM-DD (UTC)
  createdAt DateTime @default(now())

  @@index([day])
  @@index([path])
  @@index([visitorId, day])
  @@map("page_views")
}

model Feedback {
  id            String   @id @default(uuid())
  toolId        String
  rating        Int
  message       String?
  emailOptional String?
  createdAt     DateTime @default(now())

  @@index([toolId])
  @@map("feedback")
}

model ToolRequest {
  id          String   @id @default(uuid())
  title       String
  description String
  votes       Int      @default(0)
  status      String   @default("open")
  createdAt   DateTime @default(now())

  voteRows RequestVote[]

  @@map("tool_requests")
}

model RequestVote {
  requestId String
  voterHash String
  request   ToolRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, voterHash])
  @@map("request_votes")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  category  String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model BlogPost {
  slug        String
  locale      String
  title       String
  excerpt     String?
  bodyMd      String
  tags        String? // comma-separated
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([slug, locale])
  @@map("blog_posts")
}

model Subscription {
  id            String    @id @default(uuid())
  userId        String
  provider      String // "razorpay" | "stripe"
  providerSubId String?
  plan          String
  status        String
  periodEnd     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  providerPaymentId String?
  amount            Int // minor units (paise / cents)
  currency          String   @default("INR")
  status            String
  invoiceNo         String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model Job {
  id         String    @id @default(uuid())
  toolId     String
  status     String    @default("queued")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  errorCode  String?

  @@index([status])
  @@map("jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  metaJson  String?
  createdAt DateTime @default(now())

  @@map("audit_log")
}

model SiteSetting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model BugReport {
  id         String   @id @default(uuid())
  title      String
  message    String
  category   String
  severity   String   @default("medium")
  status     String   @default("new")
  toolId     String?
  email      String?
  browserInfo String?
  adminNote  String?
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("bug_reports")
}

/* ------------------------------------------------------------------ */
/* Accounting (R27) — double-entry books for the DocoPDF business.     */
/* Metadata + money only: amounts are minor units (paise/cents),      */
/* never file content. See docs/rules/17-ACCOUNTING.md.               */
/* ------------------------------------------------------------------ */

/// Chart of accounts — one row per ledger account. `code` is the
/// human/accountant-facing key journal lines reference (stable, sequential
/// 1000=assets … 5000=expenses). `isSystem` rows are seeded and cannot be
/// deleted from the UI (manual expense accounts can be added).
model Account {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  /// asset | liability | equity | revenue | expense
  type      String
  /// e.g. bank, current_asset, current_liability, operating_revenue,
  /// operating_expense, tax_payable … (display grouping)
  subtype   String   @default("other")
  isSystem  Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  lines JournalLine[]

  @@index([type])
  @@map("accounts")
}

/// A posted journal entry (immutable once posted — corrections are new
/// reversing entries, never edits; standard bookkeeping practice that
/// keeps the audit trail honest).
model JournalEntry {
  id        String   @id @default(uuid())
  /// Sequential human number: JE-000001 …
  entryNo   String   @unique
  date      DateTime
  memo      String
  /// manual | payment | refund | recognition | adjustment | opening
  source    String   @default("manual")
  /// Free-form reference (payment id, invoice no, sweep batch …)
  sourceRef String?
  createdBy String?
  createdAt DateTime @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([source])
  @@map("journal_entries")
}

/// One debit OR credit leg of a journal entry. Exactly one of debit/credit
/// is non-zero (minor units); the entry's legs always sum debits = credits
/// (validated in src/lib/accounting/post.ts before insert).
model JournalLine {
  id        String   @id @default(uuid())
  entryId   String
  accountId String
  /// Minor units — debit side (0 when this leg is a credit).
  debit     Int      @default(0)
  /// Minor units — credit side (0 when this leg is a debit).
  credit    Int      @default(0)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([entryId])
  @@map("journal_lines")
}

/// GST-compliant tax invoice issued for a paid payment. One per payment.
/// INR domestic sales split CGST+SGST (intra-state) or IGST (inter-state);
/// USD sales are zero-rated exports (no GST). Amounts minor units.
model Invoice {
  id            String   @id @default(uuid())
  /// Sequential tax-invoice number: DP-INV-000001 …
  invoiceNo     String   @unique
  paymentId     String?  @unique
  userId        String?
  customerEmail String
  customerName  String?
  customerGstin String?
  /// ISO date on the invoice face.
  issuedAt      DateTime
  /// pro_monthly | pro_yearly | manual
  itemCode      String
  /// cgst_sgst | igst | export
  taxType       String
  /// Minor units — net taxable value.
  taxableAmount Int
  /// Minor units — total GST (== cgst+sgst or igst; 0 on exports).
  taxAmount     Int
  /// Minor units — taxable + tax (== payment amount).
  totalAmount   Int
  currency      String   @default("INR")
  /// paid | refunded | void
  status        String   @default("paid")
  createdAt     DateTime @default(now())

  @@index([issuedAt])
  @@index([userId])
  @@map("invoices")
}
