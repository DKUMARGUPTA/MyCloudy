// DocoPDF database schema — mirrors PRD §2.5 (Turso/libSQL tables).
// Sandbox: Prisma + SQLite. Production: swap datasource to Turso (libSQL)
// or port to Drizzle — table/column names match the PRD exactly.
//
// HARD RULE: metadata only. NEVER store PDF content or file names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  name         String?
  passwordHash String?
  oauthId      String?
  plan         String    @default("free")
  locale       String    @default("en")
  role         String    @default("user")
  tokenVersion Int       @default(0)
  bannedAt     DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  sessions      Session[]
  subscriptions Subscription[]
  payments      Payment[]
  bugReports     BugReport[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  uaHash    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AnonUsage {
  anonId String
  toolId String
  day    String // YYYY-MM-DD
  count  Int    @default(0)

  @@id([anonId, toolId, day])
  @@map("anon_usage")
}

model UsageEvent {
  id         String   @id @default(uuid())
  toolId     String
  mode       String // "D" | "S"
  success    Boolean
  durationMs Int
  sizeBucket String
  locale     String
  day        String
  createdAt  DateTime @default(now())

  @@index([toolId, day])
  @@map("usage_events")
}

model Feedback {
  id            String   @id @default(uuid())
  toolId        String
  rating        Int
  message       String?
  emailOptional String?
  createdAt     DateTime @default(now())

  @@index([toolId])
  @@map("feedback")
}

model ToolRequest {
  id          String   @id @default(uuid())
  title       String
  description String
  votes       Int      @default(0)
  status      String   @default("open")
  createdAt   DateTime @default(now())

  voteRows RequestVote[]

  @@map("tool_requests")
}

model RequestVote {
  requestId String
  voterHash String
  request   ToolRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, voterHash])
  @@map("request_votes")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  category  String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model BlogPost {
  slug        String
  locale      String
  title       String
  excerpt     String?
  bodyMd      String
  tags        String? // comma-separated
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([slug, locale])
  @@map("blog_posts")
}

model Subscription {
  id            String    @id @default(uuid())
  userId        String
  provider      String // "razorpay" | "stripe"
  providerSubId String?
  plan          String
  status        String
  periodEnd     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  providerPaymentId String?
  amount            Int // minor units (paise / cents)
  currency          String   @default("INR")
  status            String
  invoiceNo         String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model Job {
  id         String    @id @default(uuid())
  toolId     String
  status     String    @default("queued")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  errorCode  String?

  @@index([status])
  @@map("jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  metaJson  String?
  createdAt DateTime @default(now())

  @@map("audit_log")
}

model SiteSetting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model BugReport {
  id         String   @id @default(uuid())
  title      String
  message    String
  category   String
  severity   String   @default("medium")
  status     String   @default("new")
  toolId     String?
  email      String?
  browserInfo String?
  adminNote  String?
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("bug_reports")
}
